# Copy this file to .env and fill in your values
# Vite exposes only variables prefixed with VITE_ to the browser

# Your GreenGuild AI backend base URL
VITE_API_URL=https://api.greenguild.ai/v1

# VAPID public key for push notifications (copy from backend generate-vapid-keys.js output)
VITE_VAPID_PUBLIC_KEY=
